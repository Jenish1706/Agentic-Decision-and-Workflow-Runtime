# Copy this file to .env and adjust as needed. All values have sane defaults
# in src/agent_runtime/config.py — .env only needs to override them.

# --- LLM backend (Ollama, local) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVE=8
TOP_K_RERANK=3

# --- Agent ---
MAX_AGENT_STEPS=8
MAX_DECISION_RETRIES=2
